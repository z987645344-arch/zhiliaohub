# Docker Compose variables only. Copy this file to .env on the deployment server.
# Do not put admin passwords, session secrets, TOTP keys or backup passwords here.

# Gateway topology safety boundary: hub Nginx must bind loopback only because it no longer
# terminates TLS or redirects HTTP to HTTPS. Never change this to a public interface by itself.
SERVER_PUBLIC_IP=127.0.0.1
SERVER_HTTP_PORT=80
SERVER_NAME=localhost
LAB_SERVER_NAME=lab.localhost
# Determine this network from the deployment host after Compose creates app-network.
# Trust only the backend Compose bridge gateway CIDR; never use 0.0.0.0/0.
TRUSTED_PROXY_CIDR=CHANGE_ME_COMPOSE_BRIDGE_GATEWAY_CIDR
NGINX_CLIENT_MAX_BODY_SIZE=100m
ZHILIAOHUB_IMAGE_TAG=local

# TLS_CERT_PATH, TLS_KEY_PATH and SERVER_HTTPS_PORT are intentionally unused here.
# The unique front gateway owns HTTPS certificates and the public :443 listener.

# One dedicated runtime parent. Absolute server paths are recommended in production.
# data/content/uploads/backups/lab-storage/site MUST all be direct children of this one
# parent: restore swaps those child directories atomically, which cannot work when each
# child is itself a bind-mount root. This is a restore-correctness requirement, not a preference.
# runtime/site must contain only public frontend files, never the whole Git checkout.
RUNTIME_ROOT_PATH=./runtime
