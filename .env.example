# Docker Compose variables only. Copy this file to .env on the deployment server.
# Do not put admin passwords, session secrets, TOTP keys or backup passwords here.

# Safe local placeholders. Replace them in the server-only .env; do not edit docker-compose.yml.
SERVER_PUBLIC_IP=127.0.0.1
SERVER_HTTP_PORT=80
SERVER_HTTPS_PORT=443
SERVER_NAME=localhost
LAB_SERVER_NAME=lab.localhost
NGINX_CLIENT_MAX_BODY_SIZE=100m
ZHILIAOHUB_IMAGE_TAG=local

# Server-only certificate files. These placeholder paths are not real certificates.
TLS_CERT_PATH=./runtime/tls/fullchain.pem
TLS_KEY_PATH=./runtime/tls/privkey.pem

# Dedicated runtime directories. Absolute server paths are recommended in production.
# The site directory must contain only public frontend files, never the whole Git checkout.
ADMIN_DATA_PATH=./runtime/admin-data
ADMIN_CONTENT_PATH=./runtime/admin-content
ADMIN_UPLOADS_PATH=./runtime/admin-uploads
ADMIN_BACKUPS_PATH=./runtime/admin-backups
ADMIN_LAB_STORAGE_PATH=./runtime/lab-storage
SITE_ROOT_PATH=./runtime/site
