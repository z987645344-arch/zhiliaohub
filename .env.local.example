# ⚠️ 本机验证专用，绝不可用于服务器。
#
# 服务器的 .env 仍以 .env.example 为准。本文件只为在开发机上真实跑一遍
# docker compose，把 nginx 配置、TLS、路由、CSP 头和编排关系提前验一遍——
# 在此之前这些东西要到服务器才第一次真实运行。
#
# 用法：cp .env.local.example .env.local
#       docker compose --env-file .env.local up -d
# 具体步骤见 admin-server/deploy/README.md 的「本机 Compose 验证」一节。
#
# 关键约束：本机与服务器共用同一份 docker-compose.yml 和同一份
# deploy/nginx.conf，只换 .env。不要新建 docker-compose.local.yml 或本机专用
# 的 nginx 配置——那会制造第二个真相源，本机验的就不再是生产要跑的东西。

# 本机监听。Windows 上 80/443 常被占用或需要特权，故改用 8080/8443。
# 服务器上仍是 80/443。
SERVER_PUBLIC_IP=127.0.0.1
SERVER_HTTP_PORT=8080
SERVER_HTTPS_PORT=8443
SERVER_NAME=localhost
LAB_SERVER_NAME=lab.localhost
NGINX_CLIENT_MAX_BODY_SIZE=100m
ZHILIAOHUB_IMAGE_TAG=local

# 自签证书，由 deploy/generate-local-tls.sh 生成，SAN 覆盖 localhost 与
# lab.localhost。浏览器会警告不受信任——这是预期的，本机验不了真实信任链。
TLS_CERT_PATH=./runtime/tls/fullchain.pem
TLS_KEY_PATH=./runtime/tls/privkey.pem

# 本机运行时目录。runtime/ 整个被 .gitignore 忽略，不会入库。
# 注意这几个目录与 admin-server/data/ 是分开的，跑 compose 不会动本地开发库。
ADMIN_DATA_PATH=./runtime/admin-data
ADMIN_CONTENT_PATH=./runtime/admin-content
ADMIN_UPLOADS_PATH=./runtime/admin-uploads
ADMIN_BACKUPS_PATH=./runtime/admin-backups
ADMIN_LAB_STORAGE_PATH=./runtime/lab-storage
SITE_ROOT_PATH=./runtime/site
