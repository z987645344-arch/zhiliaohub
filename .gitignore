# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Editor settings and temporary files
.idea/
.vscode/
.workbuddy/
*.swp
*.swo
*~

# Runtime leftovers
*.log
.env
.env.*
!.env*.example
/runtime/

# Local-only character reference supplied by the project owner
/assets/reference/oc-three-view.jpg
/assets/concepts/

# Image source material. assets/ tracks finished .webp only; raster sources and
# generation prompts stay local. Binaries pushed to this public repo stay in Git
# history forever and cannot be removed. These patterns are anchored to the
# assets/ root, so subdirectories are unaffected. If a raster file ever genuinely
# belongs in the repo, convert it to .webp (the established convention) or
# override deliberately with `git add -f`.
/assets/*.png
/assets/*.jpg
/assets/*.jpeg
/assets/image-prompts/

# Admin server dependencies and secrets
/admin-server/node_modules/
/admin-server/.npm-cache/

# Admin server runtime data
/admin-server/data/*
!/admin-server/data/.gitkeep
!/admin-server/data/schema.sql
/admin-server/uploads/*
!/admin-server/uploads/.gitkeep
/admin-server/lab-storage/*
!/admin-server/lab-storage/.gitkeep
/admin-server/backups/*
!/admin-server/backups/.gitkeep
/admin-server/content/**/*.tmp-*
