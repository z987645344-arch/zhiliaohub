# Server
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
TRUST_PROXY_HOPS=0
# For same-WiFi development only, set HOST=0.0.0.0 and keep the computer firewall scoped to a trusted private network.

# Generate a long random value; never commit the real value.
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_MAX_AGE_MS=28800000
SESSION_CLEANUP_INTERVAL_MS=900000

# Optional fixed display name. There is no registration endpoint.
ADMIN_USERNAME=admin

# bcrypt hash only; never put the plaintext password here.
ADMIN_PASSWORD_HASH=$2b$12$replace_with_a_real_bcrypt_hash

# Base64-encoded 32-byte key used to encrypt the stored TOTP secret.
TOTP_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# Authentication limits are applied by requester IP, never by account lockout.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=8

# Device pairing and challenge-response login limits.
PAIRING_CODE_TTL_MS=300000
DEVICE_CHALLENGE_TTL_MS=120000
DEVICE_AUTH_RATE_LIMIT_WINDOW_MS=900000
DEVICE_AUTH_RATE_LIMIT_MAX=30

# Public feedback submissions are limited by requester IP. All accepted entries remain pending review.
FEEDBACK_RATE_LIMIT_WINDOW_MS=900000
FEEDBACK_RATE_LIMIT_MAX=5

# Upload/content limits
UPLOAD_MAX_BYTES=104857600
CONTENT_MAX_BYTES=1048576

# Small workshop ZIP extraction limits and the public link prefix.
LAB_MAX_FILES=500
LAB_MAX_UNCOMPRESSED_BYTES=104857600
LAB_BASE_URL=http://localhost:3001/lab

# Optional local path overrides. Relative paths resolve from admin-server/.
# DATA_DIR=data
# SCHEMA_PATH=data/schema.sql
# CONTENT_DIR=content
# UPLOAD_DIR=uploads
# LAB_STORAGE_DIR=lab-storage
# Static front-end directory that full publishing writes into. Defaults to the repository
# root (admin-server/..); containers must point this at the mounted front-end directory.
# SITE_ROOT=..

# Local backup archive directory and retention. Leave the password empty for unencrypted archives.
# BACKUP_DIR=backups
BACKUP_RETENTION_COUNT=3
# ZIP files are included by default. Set true to omit their contents while retaining
# path, size and SHA-256 metadata in manifest.excluded for manual refill after restore.
BACKUP_EXCLUDE_ZIP=false
# Restores first snapshot the current data as pre-restore-<timestamp>.tar.gz. These
# snapshots prune against their own count, independent of BACKUP_RETENTION_COUNT.
PRE_RESTORE_RETENTION_COUNT=3
# Required by restore operations, not by backup creation. Use the hub Nginx loopback HTTP
# address with the exact /health path, for example http://127.0.0.1:<backend-port>/health.
# Never point this at the gateway or a public domain: a gateway failure cannot prove that
# admin-server stopped, and migration DNS may still reach the old server.
# RESTORE_PROBE_URL=http://127.0.0.1:<backend-port>/health

# In-process scheduled backup. The wall clock is always interpreted as fixed UTC+8 and does
# not depend on the container timezone. An empty backup directory is protected at startup;
# later restarts only catch up if the current UTC+8 schedule boundary has no backup yet.
BACKUP_SCHEDULE_ENABLED=true
BACKUP_SCHEDULE_LOCAL_TIME="00:00"

# Optional second copy of every finished archive. Leave empty to disable.
# ⚠ Today this can only be another directory on the SAME machine, which is a SIMULATION of
# off-site backup. It does NOT protect against losing the server itself. Real off-site
# protection needs a remote object store and has not been implemented yet.
# BACKUP_MIRROR_DIR=../backup-mirror
# BACKUP_ENCRYPTION_PASSWORD=replace-with-a-strong-backup-only-password
