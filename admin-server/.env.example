# Server
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
TRUST_PROXY_HOPS=0

# Generate a long random value; never commit the real value.
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_MAX_AGE_MS=28800000
SESSION_CLEANUP_INTERVAL_MS=900000

# Optional fixed display name. There is no registration endpoint.
ADMIN_USERNAME=admin

# bcrypt hash only; never put the plaintext password here.
ADMIN_PASSWORD_HASH=$2b$12$replace_with_a_real_bcrypt_hash

# Base64-encoded 32-byte key used to encrypt the stored TOTP secret.
TOTP_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# Authentication limits are applied by requester IP, never by account lockout.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=8

# Device pairing and challenge-response login limits.
PAIRING_CODE_TTL_MS=300000
DEVICE_CHALLENGE_TTL_MS=120000
DEVICE_AUTH_RATE_LIMIT_WINDOW_MS=900000
DEVICE_AUTH_RATE_LIMIT_MAX=30

# Upload/content limits
UPLOAD_MAX_BYTES=26214400
CONTENT_MAX_BYTES=1048576

# Optional local path overrides. Relative paths resolve from admin-server/.
# DATA_DIR=data
# SCHEMA_PATH=data/schema.sql
# CONTENT_DIR=content
# UPLOAD_DIR=uploads

# Local backup archive directory and retention. Leave the password empty for unencrypted archives.
# BACKUP_DIR=backups
BACKUP_RETENTION_COUNT=7
# BACKUP_ENCRYPTION_PASSWORD=replace-with-a-strong-backup-only-password
